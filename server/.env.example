# Clés API utilisées par le serveur pour interroger SNCF / IDFM en tâche de
# fond (indépendamment des clés éventuellement saisies dans l'app elle-même).
SNCF_API_KEY=
IDFM_API_KEY=

# Port d'écoute HTTP.
PORT=3000

# Secret partagé optionnel mais recommandé : à fournir dans le header
# `x-tick-secret` de chaque appel à POST /tick, pour empêcher n'importe qui
# de déclencher des vérifications sur votre serveur. Générez une valeur
# aléatoire (ex: `openssl rand -hex 24`) et utilisez la même dans le service
# de cron externe qui appelle /tick.
TICK_SECRET=

# Seuil de retard (minutes) à partir duquel un passage est considéré comme
# une perturbation à notifier.
DISRUPTION_DELAY_THRESHOLD_MIN=5

# Optionnel : si défini, le serveur lance lui-même une vérification toutes les
# N minutes (utile sur un hébergeur qui garde le process actif en continu,
# ex: un VPS ou Railway). Sur un hébergeur qui met le service en veille
# (ex: Render free tier), préférez un cron externe qui appelle POST /tick.
AUTO_TICK_MINUTES=
