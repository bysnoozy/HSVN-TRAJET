# Optionnel : clés par défaut utilisées en développement (web) via `expo start --web`.
# Ces variables sont injectées au build (préfixe EXPO_PUBLIC_ requis par Expo) et ne
# remplacent pas la saisie utilisateur dans l'écran Réglages de l'app, qui reste la
# méthode normale de configuration (clé stockée localement sur l'appareil).
#
# SNCF : clé obtenue sur https://numerique.sncf.com/startup/api/
EXPO_PUBLIC_SNCF_API_KEY=

# IDFM (PRIM) : clé obtenue sur https://prim.iledefrance-mobilites.fr/
EXPO_PUBLIC_IDFM_API_KEY=
